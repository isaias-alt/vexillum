#!/bin/sh
# Fake herdr for the benchmark harness. It answers just the calls dispatch,
# land and strike make, with the JSON envelope the real CLI prints, and costs
# one shell start. It is never on PATH outside bench/.
#
# VXBENCH_PROMPT_MODE decides what "agent prompt --wait" does:
#   working  (default) the agent is already working: return at once
#   busy     the soldier is at work and stays so. A call that asks to stop at
#            "working" (--until working) gets it at once; any other call sleeps
#            for --timeout and fails with the "timeout" error, as the real
#            herdr does when it never sees one of the requested states
#   silent   herdr never sees any of the requested states, even working: every
#            call sleeps for --timeout and fails with the "timeout" error. The
#            upper bound of dispatch's probe
#   hang     the call does not return for a minute: a vx dispatch killed here
#            dies between pasting the prompt and submitting it
#
# VXBENCH_AGENT_STATUS is the agent_status "agent get" reports (default
# working), so a sentinel run against the fake can see an idle soldier.
#
# For the wake latency scenario, which needs the status to change while a
# sentinel is polling:
#   VXBENCH_STATUS_FILE  when this file exists, its first word is the status
#                        "agent get" reports, and wins over VXBENCH_AGENT_STATUS
#   VXBENCH_SEEN_FILE    created the first time "agent get" reports idle, so
#                        its mtime is the moment the sentinel saw the soldier
#                        finish
#
# "integration status" prints the three lines doctor reads, with the shape of
# the real output.

ok() {
	printf '{"id":"1","result":%s}\n' "$1"
}

if [ "$1" = "--version" ]; then
	echo "herdr 0.9.5"
	exit 0
fi

case "$1 $2" in
"tab create")
	ok '{"tab":{"tab_id":"t1"},"root_pane":{"pane_id":"p1"}}'
	;;
"tab close" | "agent start" | "agent send-keys")
	ok '{}'
	;;
"agent get")
	status="${VXBENCH_AGENT_STATUS:-working}"
	if [ -n "$VXBENCH_STATUS_FILE" ] && [ -r "$VXBENCH_STATUS_FILE" ]; then
		read -r status <"$VXBENCH_STATUS_FILE"
	fi
	if [ "$status" = idle ] && [ -n "$VXBENCH_SEEN_FILE" ] && [ ! -e "$VXBENCH_SEEN_FILE" ]; then
		: >"$VXBENCH_SEEN_FILE"
	fi
	ok '{"agent":{"agent":"claude","name":"'"$3"'","pane_id":"p1","agent_status":"'"$status"'","interactive_ready":true}}'
	;;
"integration status")
	echo "pi: current (v9) (/fake/.pi/agent/extensions/herdr-agent-state.ts)"
	echo "claude: current (v11) (/fake/.claude/hooks/herdr-agent-state.sh)"
	echo "opencode: current (v13) (/fake/.config/opencode/plugins/herdr-agent-state.js)"
	;;
"agent list")
	ok '{"agents":[]}'
	;;
"agent read")
	echo "fake transcript"
	;;
"agent wait" | "agent prompt")
	timeout_ms=15000
	until_working=no
	prev=""
	for arg in "$@"; do
		if [ "$prev" = "--timeout" ]; then
			timeout_ms="$arg"
		fi
		if [ "$prev" = "--until" ] && [ "$arg" = "working" ]; then
			until_working=yes
		fi
		prev="$arg"
	done
	case "${VXBENCH_PROMPT_MODE:-working}" in
	hang)
		sleep 60
		;;
	busy | silent)
		if [ "$until_working" = "no" ] || [ "${VXBENCH_PROMPT_MODE}" = "silent" ]; then
			sleep "$((timeout_ms / 1000))"
			printf '{"id":"1","error":{"code":"timeout","message":"timed out waiting for the agent"}}\n' >&2
			exit 1
		fi
		;;
	esac
	ok '{"agent":{"agent_status":"working"}}'
	;;
*)
	printf '{"id":"1","error":{"code":"unsupported","message":"fake herdr does not know: %s"}}\n' "$*" >&2
	exit 2
	;;
esac

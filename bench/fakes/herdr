#!/bin/sh
# Fake herdr for the benchmark harness. It answers just the calls dispatch,
# land and strike make, with the JSON envelope the real CLI prints, and costs
# one shell start. It is never on PATH outside bench/.
#
# VXBENCH_PROMPT_MODE decides what "agent prompt --wait" does:
#   working  (default) the agent is already working: return at once
#   busy     the soldier is still at work: sleep for --timeout, then fail with
#            the "timeout" error, as the real herdr does when the quick-settle
#            probe of dispatch expires

ok() {
	printf '{"id":"1","result":%s}\n' "$1"
}

if [ "$1" = "--version" ]; then
	echo "herdr 0.9.5"
	exit 0
fi

case "$1 $2" in
"tab create")
	ok '{"tab":{"tab_id":"t1"},"root_pane":{"pane_id":"p1"}}'
	;;
"tab close" | "agent start" | "agent send-keys")
	ok '{}'
	;;
"agent get")
	ok '{"agent":{"agent":"claude","name":"'"$3"'","pane_id":"p1","agent_status":"working","interactive_ready":true}}'
	;;
"agent list")
	ok '{"agents":[]}'
	;;
"agent read")
	echo "fake transcript"
	;;
"agent wait" | "agent prompt")
	if [ "${VXBENCH_PROMPT_MODE:-working}" = "busy" ]; then
		timeout_ms=15000
		prev=""
		for arg in "$@"; do
			if [ "$prev" = "--timeout" ]; then
				timeout_ms="$arg"
			fi
			prev="$arg"
		done
		sleep "$((timeout_ms / 1000))"
		printf '{"id":"1","error":{"code":"timeout","message":"timed out waiting for the agent"}}\n' >&2
		exit 1
	fi
	ok '{"agent":{"agent_status":"working"}}'
	;;
*)
	printf '{"id":"1","error":{"code":"unsupported","message":"fake herdr does not know: %s"}}\n' "$*" >&2
	exit 2
	;;
esac
